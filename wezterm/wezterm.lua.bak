local wezterm = require 'wezterm'
local config = {}

if wezterm.config_builder then
  config = wezterm.config_builder()
end

----------------------------------------------------------------
-- 1. UI & COLORS
----------------------------------------------------------------
config.color_scheme = "Catppuccinno Mocha"
config.force_reverse_video_cursor = true
config.font = wezterm.font({
  family = "SF Mono",
  weight = "Medium",
})
config.font_size = 11

config.inactive_pane_hsb = {
  saturation = 0.9,
  brightness = 0.9,
}

-- Arrow Constants
local SOLID_LEFT_ARROW = wezterm.nerdfonts.pl_right_hard_divider
local SOLID_RIGHT_ARROW = wezterm.nerdfonts.pl_left_hard_divider

config.colors = {
  cursor_bg = '#fa52b8',
  cursor_fg = 'black',
  compose_cursor = 'orange',
  cursor_border = 'white',
  tab_bar = {
    background = '#1b1b1b',
    active_tab = {
      italic = true,
      bg_color = 'orange',
      fg_color = '#1b1b1b',
      intensity = 'Bold',
    },
    inactive_tab = {
      bg_color = '#1b1b1b',
      fg_color = 'springgreen',
    },
    inactive_tab_hover = {
      bg_color = '#1b1b1b',
      fg_color = 'springgreen',
      italic = true,
    },
    new_tab = {
      bg_color = '#262629',
      fg_color = 'white',
      intensity = 'Bold',
    },
    new_tab_hover = {
      bg_color = '#1b1b1b',
      fg_color = 'springgreen',
      italic = false,
    },
  },
}

-- THE FIX: These decorative elements MUST go in window_frame
config.window_frame = {
  active_titlebar_bg = '#262629',
  inactive_titlebar_bg = '#1b1b1b',
}

-- Re-implementing the style via the format-tab-title event 
-- as it is the most reliable way to get these specific arrows on the tabs themselves.
wezterm.on('format-tab-title', function(tab, tabs, panes, config, hover, max_width)
  local background = 'black'
  local foreground = 'springgreen'
  local edge_background = 'springgreen'

  if tab.is_active then
    background = '#262629'
    foreground = '262629'
  end

  local title = tab.active_pane.title

  return {
    { Background = { Color = edge_background } },
    { Foreground = { Color = foreground } },
    { Text = SOLID_LEFT_ARROW },
    { Background = { Color = background } },
    { Foreground = { Color = 'white' } },
    { Text = ' ' .. title .. ' ' },
    { Background = { Color = edge_background } },
    { Foreground = { Color = foreground } },
    { Text = SOLID_RIGHT_ARROW },
  }
end)

config.window_background_gradient = {
  orientation = 'Vertical',
  colors = { '#262629', '#0c0c0d', '#262629' },
  interpolation = 'Basis',
  blend = 'Rgb',
}

----------------------------------------------------------------
-- 2. TAB BAR CONFIGURATION
----------------------------------------------------------------
config.use_fancy_tab_bar = false 
config.tab_bar_at_bottom = true
config.hide_tab_bar_if_only_one_tab = true
config.tab_max_width = 32

----------------------------------------------------------------
-- 3. STATUS BAR (Right Side Info)
----------------------------------------------------------------

wezterm.on('update-right-status', function(window, pane)
  local cells = {}
  local leader = ''
  if window:leader_is_active() then
    leader = 'LEADER'
    table.insert(cells, {Background={Color='orange'}, Foreground={Color='#1b1b1b'}, Text=' '..leader..' '})
  end

  local date = wezterm.strftime('%a %b %-d')
  table.insert(cells, {Foreground={Color='white'}, Text=date})
  local time = wezterm.strftime('%H:%M')
  table.insert(cells, {Foreground={Color='yellow'}, Text=time})

  local elements = {}
  for i, cell in ipairs(cells) do
    table.insert(elements, { Foreground = { Color = 'cyan' } })
    table.insert(elements, { Background = { Color = '#1b1b1b' } }) 
    table.insert(elements, { Text = ' 🐌 🐟 🐟 '})
    if cell.Background then table.insert(elements, { Background = cell.Background }) end
    if cell.Foreground then table.insert(elements, { Foreground = cell.Foreground }) end
    table.insert(elements, { Text = cell.Text .. ' ' })
  end
  window:set_right_status(wezterm.format(elements))
end)

----------------------------------------------------------------
-- 4. GENERAL SETTINGS
----------------------------------------------------------------

config.bold_brightens_ansi_colors = true
config.cursor_blink_rate = 200
config.audible_bell = "SystemBeep"
config.window_background_image_hsb = {
  brightness = 0.99,
  saturation = 0.99,
  hue = 1,
}

config.window_background_opacity = 1
config.harfbuzz_features = { "calt=1", "clig=1", "liga=1" }
config.line_height = 1.1
config.cell_width = 1.0
config.window_decorations = "RESIZE" 
config.initial_cols = 90
config.initial_rows = 40
config.enable_scroll_bar = false
config.enable_tab_bar = true
config.scrollback_lines = 10000
config.default_cursor_style = "BlinkingBlock"
config.cursor_blink_ease_in = "Constant"
config.cursor_blink_ease_out = "Constant"

config.window_padding = {
  left = 10,
  right = 10,
  top = 10,
  bottom = 10,
}

config.hyperlink_rules = wezterm.default_hyperlink_rules()
config.leader = { key = "b", mods = "CTRL" }
config.keys = {
  { key = 'o', mods = 'LEADER', action = wezterm.action.ShowLauncher },
  { key = 't', mods = 'LEADER', action = wezterm.action.SpawnTab "CurrentPaneDomain" },
  { key = 'r', mods = 'LEADER', action = wezterm.action.CloseCurrentPane { confirm = false } },
  { key = 'h', mods = 'LEADER', action = wezterm.action.SplitHorizontal { domain = "CurrentPaneDomain" } },
  { key = 'v', mods = 'LEADER', action = wezterm.action.SplitVertical { domain = "CurrentPaneDomain" } },
  { key = 'LeftArrow', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection "Left" },
  { key = 'RightArrow', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection "Right" },
  { key = 'UpArrow', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection "Up" },
  { key = 'DownArrow', mods = 'LEADER', action = wezterm.action.ActivatePaneDirection "Down" },
  { key = '1', mods = 'CTRL', action = wezterm.action.ActivateTab(0) },
  { key = '2', mods = 'CTRL', action = wezterm.action.ActivateTab(1) },
  { key = '3', mods = 'CTRL', action = wezterm.action.ActivateTab(2) },
  { key = '4', mods = 'CTRL', action = wezterm.action.ActivateTab(3) },
  { key = '5', mods = 'CTRL', action = wezterm.action.ActivateTab(4) },
  { key = '6', mods = 'CTRL', action = wezterm.action.ActivateTab(5) },
  { key = '7', mods = 'CTRL', action = wezterm.action.ActivateTab(6) },
  { key = '8', mods = 'CTRL', action = wezterm.action.ActivateTab(7) },
  { key = '9', mods = 'CTRL', action = wezterm.action.ActivateTab(8) },
}

return config
